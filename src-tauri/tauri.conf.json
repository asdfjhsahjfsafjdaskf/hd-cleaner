{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HD Cleaner",
  "version": "0.1.0",
  "identifier": "app.hdcleaner.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HD Cleaner",
        "width": 1380,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0f1318"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Disk analyzer and uninstaller",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}